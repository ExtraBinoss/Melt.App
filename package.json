{
  "name": "musart-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Open-source local-first creative editor with React Three Fiber, Three.js WebGPURenderer, and TSL.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "brand:social": "bun scripts/brand-social.ts",
    "metrics": "bun scripts/metrics/cli.ts",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:prepare": "bun scripts/deploy/package.ts prepare",
    "deploy:verify": "bun scripts/deploy/package.ts verify",
    "deploy:dry-run": "wrangler deploy --env production --dry-run --outdir artifacts/cloudflare/dry-run",
    "test:deployment": "playwright test --config test/deployment/playwright.config.ts --project chromium",
    "typecheck": "tsc --noEmit && tsc -p packages/core/tsconfig.json",
    "lint:oxlint": "oxlint --type-aware .",
    "lint:react": "eslint . --max-warnings 0",
    "lint": "bun run lint:oxlint && bun run lint:react",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:related": "vitest related --run",
    "test:coverage:related": "bun scripts/test-related-coverage.ts",
    "test:coverage:changed": "bun scripts/test-related-coverage.ts --direct",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "check:rules": "bun scripts/check-rules.ts",
    "check-ci": "bun run version:check && bun run check:rules && bun run typecheck && bun run lint && bun run format:check && bun run test:coverage && bun run check:coverage && vite build",
    "check": "bun run check-ci && bun run test:browser",
    "headless": "bun scripts/headless.ts",
    "agent:bridge": "bun scripts/agent-bridge/server.ts",
    "agent:request": "bun scripts/agent-bridge/client.ts",
    "check:coverage": "bun scripts/check-rules.ts --coverage",
    "test:segmentation": "bun scripts/verify-segmentation.ts",
    "version:check": "bun scripts/release.ts --check",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@radix-ui/react-roving-focus": "1.2.1",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "fflate": "0.8.3",
    "i18next": "26.6.0",
    "idb": "8.0.4",
    "jotai": "3.0.1",
    "lucide-react": "1.66.0",
    "mediabunny": "1.65.0",
    "motion": "14.9.0",
    "onnxruntime-web": "1.31.1",
    "opentype.js": "2.0.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.10",
    "react-resizable-panels": "4.16.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "text-shaper": "0.1.28",
    "three": "0.187.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@imagemagick/magick-wasm": "0.0.45",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.4",
    "@types/clipper-lib": "6.4.0",
    "@types/node": "26.6.6",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@webgpu/types": "0.1.74",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "magic-string": "1.4.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.2",
    "yaml": "2.9.1"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "text-shaper@0.1.28": "patches/text-shaper@0.1.28.patch",
    "@radix-ui/react-menu@2.2.1": "patches/@radix-ui%2Freact-menu@2.2.1.patch"
  }
}
